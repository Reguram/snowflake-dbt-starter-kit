# Snowflake dbt Starter Kit — Connection Profile Template
# Copy this to ~/.dbt/profiles.yml and fill in environment variables or values.
# DO NOT commit credentials to version control.

snowflake_dbt_starter_kit:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', 'DBT_ROLE') }}"
      database: "{{ env_var('SNOWFLAKE_DATABASE', 'DBT_DEV') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE', 'DBT_AGENT_WH') }}"
      schema: "{{ env_var('SNOWFLAKE_SCHEMA', 'PUBLIC') }}"
      threads: 4
      client_session_keep_alive: true
      query_tag: "dbt_starter_kit"

    prod:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', 'DBT_ROLE') }}"
      database: "{{ env_var('SNOWFLAKE_DATABASE', 'DBT_PROD') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE', 'DBT_AGENT_WH') }}"
      schema: "{{ env_var('SNOWFLAKE_SCHEMA', 'PUBLIC') }}"
      threads: 8
      client_session_keep_alive: true
      query_tag: "dbt_starter_kit"

